<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core Typography & Structural Tokens -->
    <SolidColorBrush x:Key="Ink" Color="#0F172A" />
    <SolidColorBrush x:Key="Muted" Color="#475569" />
    <SolidColorBrush x:Key="Line" Color="#D8E1EC" />
    <SolidColorBrush x:Key="Rim" Color="#CBD5E1" />
    <SolidColorBrush x:Key="CardBorder" Color="#DCE4EE" />
    <SolidColorBrush x:Key="Focus" Color="#0284C7" />

    <!-- Surfaces & Elevation -->
    <SolidColorBrush x:Key="WindowSurface" Color="#EEF2F7" />
    <SolidColorBrush x:Key="Rail" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Frame" Color="#F4F7FB" />
    <LinearGradientBrush x:Key="Card" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F8FAFD" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceElevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSubtle" Color="#E6ECF4" />

    <!-- Interactive & Form Controls -->
    <SolidColorBrush x:Key="Quiet" Color="#E8EEF5" />
    <SolidColorBrush x:Key="Hover" Color="#DCE5F0" />
    <SolidColorBrush x:Key="Pressed" Color="#CBD7E6" />
    <SolidColorBrush x:Key="Primary" Color="#0284C7" />
    <SolidColorBrush x:Key="PrimaryInk" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryHover" Color="#0369A1" />
    <SolidColorBrush x:Key="PrimaryPressed" Color="#075985" />
    <SolidColorBrush x:Key="DeviceSelected" Color="#E0F2FE" />
    <SolidColorBrush x:Key="Field" Color="#94A3B8" />
    <SolidColorBrush x:Key="Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Selection" Color="#BAE6FD" />
    <SolidColorBrush x:Key="Glyph" Color="#E0F2FE" />

    <!-- Electric Cyan Accent System -->
    <SolidColorBrush x:Key="Accent" Color="#0284C7" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1C0284C7" />
    <SolidColorBrush x:Key="AccentBorder" Color="#7A0284C7" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0891B2" Offset="0" />
        <GradientStop Color="#0284C7" Offset="0.5" />
        <GradientStop Color="#2563EB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E7490" Offset="0" />
        <GradientStop Color="#0369A1" Offset="0.5" />
        <GradientStop Color="#1D4ED8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientPressed" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#155E75" Offset="0" />
        <GradientStop Color="#075985" Offset="0.5" />
        <GradientStop Color="#1E40AF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF" />

    <!-- Semantic Status & Telemetry Badges -->
    <SolidColorBrush x:Key="Ready" Color="#059669" />
    <SolidColorBrush x:Key="ReadySoft" Color="#1C059669" />
    <SolidColorBrush x:Key="Warning" Color="#D97706" />
    <SolidColorBrush x:Key="WarningSoft" Color="#1FD97706" />
    <SolidColorBrush x:Key="Danger" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerSoft" Color="#1CDC2626" />
    <SolidColorBrush x:Key="DangerInk" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PurpleAccent" Color="#7C3AED" />
    <SolidColorBrush x:Key="PurpleSoft" Color="#1C7C3AED" />
</ResourceDictionary>
