<Window x:Class="RemoteDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RemoteDesk.UI"
        Title="RemoteDesk · 远程桌面" Icon="Assets/remotedesk.ico"
        Width="1200" Height="740" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowSurface}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="12" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LightTheme.xaml" />
                <ResourceDictionary Source="GlassControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Compact action button variants -->
            <Style x:Key="CompactQuietButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>

            <Style x:Key="CompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="14,5" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>

            <!-- PasswordBox matching DeviceField styling in dark and light themes -->
            <Style x:Key="PasswordField" TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource Input}" />
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource Selection}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Field}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,0,38,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="FieldSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="FieldSurface" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Custom transparent ListBox template so IsEnabled=False dims cleanly in dark mode -->
            <Style x:Key="DarkSafeDeviceList" TargetType="ListBox" BasedOn="{StaticResource SavedDeviceList}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}" />
                                    </ScrollViewer.Resources>
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="InlineLinkButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sleek macOS Slider for Stream Bitrate -->
            <Style x:Key="ModernSlider" TargetType="Slider">
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Border Height="4" CornerRadius="2" Background="{DynamicResource ToggleTrackOff}"
                                        VerticalAlignment="Center" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" CornerRadius="2,0,0,2" Background="{DynamicResource Accent}" VerticalAlignment="Center" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" Background="Transparent" VerticalAlignment="Center" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="16" Height="16" Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8"
                                                            Background="#FFFFFF"
                                                            BorderBrush="#26000000" BorderThickness="1">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.18" />
                                                        </Border.Effect>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Knob" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Knob" Property="Background" Value="#F5F5F7" />
                                                            <Setter TargetName="Knob" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="222" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Full-Height macOS Translucent Sidebar -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource Rail}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="12,0,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Minimalist Drag Brand Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Image Source="Assets/remotedesk.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="RemoteDesk" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>

                <!-- Navigation Section with 21st.dev Sliding Capsule -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="工作台" Style="{StaticResource SectionHeader}" Margin="10,4,0,8" />

                    <Grid x:Name="NavItemsContainer">
                        <Border x:Name="NavActiveIndicator" Height="38" VerticalAlignment="Top" CornerRadius="10"
                                Background="{DynamicResource NavActivePill}"
                                BorderBrush="{DynamicResource NavActivePillBorder}" BorderThickness="1"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavIndicatorTransform" Y="0" />
                            </Border.RenderTransform>
                            <Border Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
                        </Border>

                        <StackPanel>
                            <Button x:Name="RemoteNav" Style="{StaticResource NavRailButton}" Tag="Selected"
                                    Click="ShowRemotePage" Margin="0,0,0,4"
                                    AutomationProperties.AutomationId="NavRemote" AutomationProperties.Name="远程控制">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="15" Margin="4,0,11,0" />
                                    <TextBlock Text="远程控制" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="HostNav" Style="{StaticResource NavRailButton}"
                                    Click="ShowHostPage" Margin="0,0,0,4"
                                    AutomationProperties.AutomationId="NavHost" AutomationProperties.Name="本机被控">
                                <DockPanel LastChildFill="True">
                                    <Ellipse x:Name="HostNavDot" DockPanel.Dock="Right" Width="6" Height="6"
                                             VerticalAlignment="Center" Fill="{DynamicResource Muted}" Opacity="0.45" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE977;" Style="{StaticResource Icon}" FontSize="15" Margin="4,0,11,0" />
                                        <TextBlock Text="本机被控" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <Button x:Name="NetworkNav" Style="{StaticResource NavRailButton}"
                                    Click="ShowNetworkPage" Margin="0,0,0,4"
                                    AutomationProperties.AutomationId="NavNetwork" AutomationProperties.Name="网络节点">
                                <DockPanel LastChildFill="True">
                                    <Ellipse x:Name="NetworkNavDot" DockPanel.Dock="Right" Width="6" Height="6"
                                             VerticalAlignment="Center" Fill="{DynamicResource Muted}" Opacity="0.45" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="15" Margin="4,0,11,0" />
                                        <TextBlock Text="网络节点" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <Button x:Name="EnginesNav" Style="{StaticResource NavRailButton}"
                                    Click="ShowEnginesPage" Margin="0,0,0,4"
                                    AutomationProperties.AutomationId="NavEngines" AutomationProperties.Name="引擎与设置">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15" Margin="4,0,11,0" />
                                    <TextBlock Text="引擎与设置" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Left Rail Footer: Local Device + Account Status + Engine Readiness -->
                <StackPanel Grid.Row="2">
                    <Button x:Name="SidebarLocalIdentityCard" Click="SidebarLocalIdentityClicked" Cursor="Hand" FocusVisualStyle="{x:Null}"
                            ToolTip="查看或重命名当前本机设备" AutomationProperties.AutomationId="RailLocalIdentity"
                            HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,8"
                            ui:MotionBehaviors.EnablePressScale="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="LocalCard" Style="{StaticResource SubPanelCard}" Padding="11,8"
                                        Background="{DynamicResource NavActivePill}" ui:MotionBehaviors.EnableSpotlight="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LocalCard" Property="Background" Value="{DynamicResource Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="5" Padding="6,1.5"
                                    VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="本机" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="14"
                                           Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="SidebarLocalDeviceNameText" Text="本机" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" MaxWidth="112" />
                                    <TextBlock x:Name="SidebarLocalDeviceIpText" Text="当前电脑" FontSize="10.5"
                                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="112" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Button x:Name="RailAccountCard" Click="ShowNetworkPage" Cursor="Hand" FocusVisualStyle="{x:Null}"
                            ToolTip="管理同步账号与跨网组网" AutomationProperties.AutomationId="RailAccountSummary"
                            HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,8"
                            ui:MotionBehaviors.EnablePressScale="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="AccountCard" Style="{StaticResource SubPanelCard}" Padding="11,9"
                                        Background="{DynamicResource NavActivePill}" ui:MotionBehaviors.EnableSpotlight="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="AccountCard" Property="Background" Value="{DynamicResource Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel>
                            <Ellipse x:Name="RailAccountDot" DockPanel.Dock="Right" Width="6" Height="6"
                                     VerticalAlignment="Center" Fill="{DynamicResource Muted}" Opacity="0.5" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="14"
                                           Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RailAccountTitle" Text="登录同步账号" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" MaxWidth="126" />
                                    <TextBlock x:Name="RailAccountSubtitle" Text="免配置自动组网" FontSize="10.5"
                                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="126" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <!-- Compact Engine Readiness Footer -->
                    <Button Click="ShowEnginesPage" Cursor="Hand" FocusVisualStyle="{x:Null}"
                            ToolTip="打开托管引擎中心" AutomationProperties.AutomationId="RailEngineSummary"
                            HorizontalContentAlignment="Stretch" Padding="0"
                            ui:MotionBehaviors.EnablePressScale="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="FooterCard" Style="{StaticResource SubPanelCard}" Padding="12,9"
                                        Background="{DynamicResource NavActivePill}" ui:MotionBehaviors.EnableSpotlight="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="FooterCard" Property="Background" Value="{DynamicResource Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <TextBlock x:Name="RailEngineCount" DockPanel.Dock="Right" Text="0/3"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                <TextBlock Text="核心就绪" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Ink}" />
                            </DockPanel>
                            <UniformGrid Columns="3">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Ellipse x:Name="RailNativeCoreDot" Width="6" Height="6" Margin="0,0,4,0" Fill="{DynamicResource Ready}" />
                                    <TextBlock Text="核心" FontSize="11" Foreground="{DynamicResource Muted}" ToolTip="内置原生 D3D11 高刷控制核心" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse x:Name="RailSunshineDot" Width="6" Height="6" Margin="0,0,4,0" Fill="{DynamicResource Warning}" />
                                    <TextBlock Text="SS" FontSize="11" Foreground="{DynamicResource Muted}" ToolTip="Sunshine 被控端" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse x:Name="RailEasyTierDot" Width="6" Height="6" Margin="0,0,4,0" Fill="{DynamicResource Warning}" />
                                    <TextBlock Text="ET" FontSize="11" Foreground="{DynamicResource Muted}" ToolTip="EasyTier P2P 组网" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Main Content Area -->
        <Grid x:Name="ContentSurfaceGrid" Grid.Column="1" Background="{DynamicResource WindowSurface}">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Minimalist Integrated Window Chrome Strip -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="16,0,10,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TitleStatusPill" Click="ShowEnginesPage" Style="{StaticResource CompactQuietButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,8,0"
                            MinHeight="26" Padding="10,2" ToolTip="查看托管引擎状态"
                            AutomationProperties.AutomationId="TitleEngineStatus">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="TitleStatusDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Fill="{DynamicResource Warning}" />
                            <TextBlock x:Name="TitleStatusText" Text="核心就绪 0/3" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ThemeButton" Click="ToggleTheme" Style="{StaticResource CaptionButton}"
                            AutomationProperties.AutomationId="ThemeToggle" Margin="0,0,6,0" />
                    <Border Background="{DynamicResource Line}" Width="1" Height="14" Margin="0,0,6,0" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeWindow"
                            AutomationProperties.Name="最小化" ToolTip="最小化" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="ToggleMaximized"
                            AutomationProperties.Name="最大化" ToolTip="最大化" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="CloseWindow"
                            AutomationProperties.Name="关闭窗口" ToolTip="关闭窗口" />
                </StackPanel>
            </DockPanel>

            <!-- PAGE 1: 远程控制 -->
            <Grid x:Name="RemoteControlPage" Grid.Row="1" Margin="18,2,18,16">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Saved Devices List -->
                <Border Grid.Column="0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="16" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="4,2,2,12">
                            <Button x:Name="AddFromListButton" DockPanel.Dock="Right" Click="AddDevice"
                                    Style="{StaticResource CompactQuietButton}" MinHeight="28" Padding="10,3"
                                    ToolTip="添加新电脑" AutomationProperties.Name="添加电脑"
                                    AutomationProperties.AutomationId="AddFromList">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10.5" Margin="0,0,5,0"
                                               Foreground="{DynamicResource Accent}" />
                                    <TextBlock Text="添加" FontSize="12" FontWeight="Medium" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="我的设备" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />
                                <Border Style="{StaticResource StatusPillBorder}" Margin="8,0,0,0" Padding="7,2">
                                    <TextBlock x:Name="DeviceCount" Text="0 台" FontSize="11" Foreground="{DynamicResource Muted}" />
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="DeviceList" SelectionChanged="DeviceSelectionChanged"
                                     Style="{StaticResource DarkSafeDeviceList}" ItemContainerStyle="{StaticResource SavedDeviceRow}"
                                     AutomationProperties.Name="已保存的电脑">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="重命名设备" Click="RenameDeviceFromContextMenuClicked" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="RowGlyph" Background="{DynamicResource Glyph}" CornerRadius="9"
                                                    Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <TextBlock x:Name="RowIcon" Text="&#xE7F4;" Style="{StaticResource Icon}"
                                                           FontSize="14" Foreground="{DynamicResource Accent}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                <DockPanel LastChildFill="True">
                                                    <Border x:Name="ModePill" DockPanel.Dock="Right" CornerRadius="5"
                                                            Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentSoft}">
                                                        <TextBlock x:Name="ModePillText" Text="{Binding ModeBadgeText}"
                                                                   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="CloudOnlineDot" Width="6" Height="6" Margin="0,0,6,0"
                                                                 VerticalAlignment="Center" Fill="{DynamicResource Ready}"
                                                                 Visibility="{Binding IsCloudSynced, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="112" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="{Binding TargetSubtitle}" FontSize="11"
                                                           Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding TargetSubtitle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCloudSynced}" Value="True">
                                                <Setter TargetName="ModePill" Property="Background" Value="{DynamicResource ReadySoft}" />
                                                <Setter TargetName="ModePillText" Property="Foreground" Value="{DynamicResource Ready}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBeingControlled}" Value="True">
                                                <Setter TargetName="ModePill" Property="Background" Value="{DynamicResource WarningSoft}" />
                                                <Setter TargetName="ModePillText" Property="Foreground" Value="{DynamicResource Warning}" />
                                                <Setter TargetName="CloudOnlineDot" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="CloudOnlineDot" Property="Fill" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsControllingOther}" Value="True">
                                                <Setter TargetName="ModePill" Property="Background" Value="{DynamicResource WarningSoft}" />
                                                <Setter TargetName="ModePillText" Property="Foreground" Value="{DynamicResource Warning}" />
                                                <Setter TargetName="CloudOnlineDot" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="CloudOnlineDot" Property="Fill" Value="{DynamicResource Warning}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCloudSynced}" Value="True" />
                                                    <Condition Binding="{Binding IsOnline}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="CloudOnlineDot" Property="ui:MotionBehaviors.EnablePulse" Value="True" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter TargetName="CloudOnlineDot" Property="ui:MotionBehaviors.EnablePulse" Value="False" />
                                                <Setter TargetName="CloudOnlineDot" Property="Fill" Value="{DynamicResource Muted}" />
                                                <Setter TargetName="CloudOnlineDot" Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLocalDevice}" Value="True">
                                                <Setter TargetName="RowGlyph" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                <Setter TargetName="ModePill" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                <Setter TargetName="ModePillText" Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Setter TargetName="CloudOnlineDot" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="CloudOnlineDot" Property="Fill" Value="{DynamicResource Accent}" />
                                                <Setter TargetName="CloudOnlineDot" Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="DeviceListEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="12" IsHitTestVisible="False">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="26"
                                           Foreground="{DynamicResource Muted}" Opacity="0.45" />
                                <TextBlock Text="暂无保存的电脑" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,2" />
                                <TextBlock Text="点击上方「添加」创建设备" FontSize="11.5"
                                           Foreground="{DynamicResource Muted}" Opacity="0.78" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right Column: Rich Device Dashboard / Editor / Empty State -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="0,0,4,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}" />
                    </ScrollViewer.Resources>

                    <Grid>
                        <!-- 1. Empty Hero State -->
                        <Border x:Name="EmptyView" Style="{StaticResource DashboardCard}" Padding="28">
                            <StackPanel VerticalAlignment="Center" MaxWidth="620" HorizontalAlignment="Left">
                                <Border Style="{StaticResource DeviceGlyph}">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="24" />
                                </Border>
                                <TextBlock Text="开启原生高刷远程桌面体验" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,6" />
                                <TextBlock Text="内置原生 D3D11 硬件解码控屏窗口与 Sunshine 高刷服务端，配合账号云同步和 EasyTier P2P 组网，同校局域网与跨外网均可即点即连。"
                                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="21" />

                                <Grid Margin="0,20,0,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SubPanelCard}" ui:MotionBehaviors.EnableSpotlight="True">
                                        <StackPanel>
                                            <TextBlock Text="内置原生高刷窗 · 办公/游戏双模" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                            <TextBlock Text="支持 1080p 120fps / 2K 60fps、HEVC/AV1 硬解、双向剪贴板、拖拽传文件与防窥黑屏。"
                                                       FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SubPanelCard}" ui:MotionBehaviors.EnableSpotlight="True">
                                        <StackPanel>
                                            <TextBlock Text="账号云同步 · 零 PIN 自动配对" FontWeight="SemiBold" Foreground="{DynamicResource PurpleAccent}" />
                                            <TextBlock Text="同一同步账号下的设备自动分配固定虚拟 IP 并静默互认配对，告别繁琐手动输入。"
                                                       FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="AddDeviceButton" Click="AddDevice" IsDefault="True"
                                            Style="{StaticResource HeroConnectButton}"
                                            AutomationProperties.AutomationId="AddDevice">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13.5" Margin="0,0,8,0" />
                                            <TextBlock Text="添加第一台电脑" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="查看托管引擎中心" Click="ShowEnginesPage"
                                            Style="{StaticResource QuietButton}" MinHeight="44" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Rich Device Dashboard -->
                        <StackPanel x:Name="DeviceView" Visibility="Collapsed">
                            <!-- Header Card -->
                            <Border Style="{StaticResource DashboardCard}" Padding="20,18" Margin="0,0,0,12"
                                    ui:MotionBehaviors.EnableSpotlight="True">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="RenameDeviceButton" Click="BeginRenameDeviceClicked" Style="{StaticResource QuietButton}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                                    AutomationProperties.Name="重命名设备" AutomationProperties.AutomationId="RenameDevice">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="12.5" Margin="0,0,6,0" />
                                                    <TextBlock Text="重命名" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EditDeviceButton" Click="EditDevice" Style="{StaticResource QuietButton}"
                                                    VerticalAlignment="Center" AutomationProperties.Name="编辑电脑"
                                                    AutomationProperties.AutomationId="EditDevice">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="12.5" Margin="0,0,6,0" />
                                                    <TextBlock Text="编辑" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource DeviceGlyph}" Width="48" Height="48">
                                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="22" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="DeviceNameText" FontSize="20" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="340" VerticalAlignment="Center"
                                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                    <Border x:Name="DeviceActiveModeBadge" CornerRadius="10" Padding="9,2.5" Margin="10,0,0,0"
                                                            VerticalAlignment="Center" Background="{DynamicResource AccentSoft}">
                                                        <TextBlock x:Name="DeviceActiveModeText" Text="高刷串流" FontSize="11"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                                    </Border>
                                                </StackPanel>
                                                <WrapPanel Margin="0,7,0,0">
                                                    <Border x:Name="DeviceHostPill" Style="{StaticResource StatusPillBorder}" Margin="0,0,8,2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="11"
                                                                       Foreground="{DynamicResource Accent}" Margin="0,0,6,0" />
                                                            <TextBlock x:Name="DeviceHostText" FontSize="11.5" Foreground="{DynamicResource Ink}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="DeviceLanPill" Style="{StaticResource StatusPillBorder}" Margin="0,0,8,2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE839;" Style="{StaticResource Icon}" FontSize="11"
                                                                       Foreground="{DynamicResource PurpleAccent}" Margin="0,0,6,0" />
                                                            <TextBlock x:Name="DeviceSecondaryText" FontSize="11.5" Foreground="{DynamicResource Ink}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="DeviceAppPill" Style="{StaticResource StatusPillBorder}" Margin="0,0,0,2">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE737;" Style="{StaticResource Icon}" FontSize="11"
                                                                       Foreground="{DynamicResource Muted}" Margin="0,0,6,0" />
                                                            <TextBlock x:Name="DeviceAppText" FontSize="11.5" Foreground="{DynamicResource Muted}" />
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DockPanel>

                                    <!-- Inline Device Rename Row -->
                                    <StackPanel x:Name="InlineRenamePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="RenameDeviceInput" MaxLength="40" Style="{StaticResource DeviceField}"
                                                     KeyDown="RenameDeviceInputKeyDown"
                                                     AutomationProperties.AutomationId="RenameDeviceInput" />
                                            <Button x:Name="ConfirmRenameDeviceButton" Grid.Column="1" Content="保存名称"
                                                    Click="ConfirmRenameDeviceClicked" Style="{StaticResource CompactPrimaryButton}"
                                                    MinHeight="36" Margin="8,0,0,0" AutomationProperties.AutomationId="ConfirmRenameDevice" />
                                            <Button Grid.Column="2" Content="取消" Click="CancelRenameDeviceClicked"
                                                    Style="{StaticResource CompactQuietButton}" MinHeight="36" Margin="6,0,0,0" />
                                        </Grid>
                                        <TextBlock x:Name="RenameDeviceFeedback" Visibility="Collapsed" FontSize="12"
                                                   Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Stream Quality / FPS / Bitrate Card -->
                            <Border x:Name="StreamConfigCard" Style="{StaticResource DashboardCard}" Padding="20,17" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource StatusPillBorder}"
                                                Background="{DynamicResource AccentSoft}">
                                            <TextBlock x:Name="StreamSummaryText" Text="2560×1440 · 60fps · 35 Mbps · HEVC"
                                                       FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Accent}" />
                                        </Border>
                                        <TextBlock Text="画质 · 帧率 · 码率预设" Style="{StaticResource SectionHeader}" />
                                    </DockPanel>

                                    <StackPanel x:Name="StreamConfigBody">
                                        <!-- 4 Preset Tiles -->
                                        <UniformGrid Columns="4" Margin="0,0,0,14">
                                            <Button x:Name="PresetUltra120Button" Style="{StaticResource PresetCardButton}"
                                                    Click="SelectPresetUltra120" Margin="0,0,6,0"
                                                    AutomationProperties.AutomationId="PresetUltra120">
                                                <StackPanel>
                                                    <TextBlock Text="极速 120fps" FontSize="13.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="1080p · 120fps · 45M" FontSize="11"
                                                               Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="PresetHigh2KButton" Style="{StaticResource PresetCardButton}"
                                                    Click="SelectPresetHigh2K" Margin="3,0,3,0"
                                                    AutomationProperties.AutomationId="PresetHigh2K">
                                                <StackPanel>
                                                    <TextBlock Text="高清 2K" FontSize="13.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="2K · 60fps · 35M" FontSize="11"
                                                               Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="PresetSaverButton" Style="{StaticResource PresetCardButton}"
                                                    Click="SelectPresetSaver" Margin="3,0,3,0"
                                                    AutomationProperties.AutomationId="PresetSaver">
                                                <StackPanel>
                                                    <TextBlock Text="省流模式" FontSize="13.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="1080p · 60fps · 12M" FontSize="11"
                                                               Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="PresetCustomButton" Style="{StaticResource PresetCardButton}"
                                                    Click="SelectPresetCustom" Margin="6,0,0,0"
                                                    AutomationProperties.AutomationId="PresetCustom">
                                                <StackPanel>
                                                    <TextBlock Text="自定义" FontSize="13.5" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="CustomPresetSubtitle" Text="手动微调参数" FontSize="11"
                                                               Foreground="{DynamicResource Muted}" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>

                                            <!-- Fine-grained Parameter Row 1: Resolution, FPS, Codec -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="分辨率" FontSize="12" Foreground="{DynamicResource Muted}" Margin="2,0,0,5" />
                                                    <ComboBox x:Name="ResolutionCombo" Style="{StaticResource ModernComboBox}"
                                                              MinHeight="36" SelectionChanged="StreamParamChanged">
                                                        <ComboBoxItem Content="1920x1080" Tag="1920x1080" />
                                                        <ComboBoxItem Content="2560x1440" Tag="2560x1440" />
                                                        <ComboBoxItem Content="2560x1600" Tag="2560x1600" />
                                                        <ComboBoxItem Content="3840x2160" Tag="3840x2160" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="目标帧率" FontSize="12" Foreground="{DynamicResource Muted}" Margin="2,0,0,5" />
                                                    <ComboBox x:Name="FpsCombo" Style="{StaticResource ModernComboBox}"
                                                              MinHeight="36" SelectionChanged="StreamParamChanged">
                                                        <ComboBoxItem Content="30 FPS" Tag="30" />
                                                        <ComboBoxItem Content="60 FPS" Tag="60" />
                                                        <ComboBoxItem Content="90 FPS" Tag="90" />
                                                        <ComboBoxItem Content="120 FPS" Tag="120" />
                                                        <ComboBoxItem Content="144 FPS" Tag="144" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="视频编码" FontSize="12" Foreground="{DynamicResource Muted}" Margin="2,0,0,5" />
                                                    <ComboBox x:Name="CodecCombo" Style="{StaticResource ModernComboBox}"
                                                              MinHeight="36" SelectionChanged="StreamParamChanged">
                                                        <ComboBoxItem Content="Auto (自动)" Tag="Auto" />
                                                        <ComboBoxItem Content="HEVC (H.265)" Tag="H265" />
                                                        <ComboBoxItem Content="H.264" Tag="H264" />
                                                        <ComboBoxItem Content="AV1" Tag="Av1" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Fine-grained Parameter Row 2: Bitrate Slider + Hardware Decode Toggle -->
                                            <Border Style="{StaticResource SubPanelCard}" Padding="14,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock x:Name="BitrateValueText" DockPanel.Dock="Right" Text="35 Mbps"
                                                                       FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Accent}" />
                                                            <TextBlock Text="视频码率 (5 – 150 Mbps)" FontSize="12" Foreground="{DynamicResource Muted}" />
                                                        </DockPanel>
                                                        <Slider x:Name="BitrateSlider" Style="{StaticResource ModernSlider}"
                                                                Minimum="5" Maximum="150" Value="35"
                                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                                ValueChanged="BitrateSliderValueChanged"
                                                                Thumb.DragStarted="BitrateSliderDragStarted"
                                                                Thumb.DragCompleted="BitrateSliderDragCompleted" />
                                                    </StackPanel>

                                                    <Border Grid.Column="1" Width="1" Background="{DynamicResource Line}"
                                                            HorizontalAlignment="Center" Margin="0,2" />

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="显卡硬件解码" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,6" />
                                                        <CheckBox x:Name="HardwareDecodeToggle" Style="{StaticResource ModernToggleSwitch}"
                                                                  Content="已开启" IsChecked="True"
                                                                  Checked="HardwareDecodeChanged" Unchecked="HardwareDecodeChanged" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Optional Security PIN Inline Prompt Card (shown when target enabled independent PIN) -->
                                <Border x:Name="SecurityPinPromptCard" Visibility="Collapsed" Style="{StaticResource DashboardCard}"
                                        BorderBrush="{DynamicResource Warning}" Padding="18,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Content="取消" Click="CancelSecurityPinPromptClicked"
                                                    Style="{StaticResource CompactQuietButton}" MinHeight="28" Padding="10,2" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="15"
                                                           Foreground="{DynamicResource Warning}" Margin="0,0,8,0" />
                                                <TextBlock Text="目标电脑已开启独立安全密码" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock x:Name="SecurityPinPromptHint"
                                                   Text="首次自动配对需要验证目标电脑设置的独立安全密码，验证通过后将自动完成配对并直连。"
                                                   FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="ConnectSecurityPinBox" Style="{StaticResource PasswordField}"
                                                         Padding="12,0,12,0"
                                                         AutomationProperties.AutomationId="ConnectSecurityPinBox" />
                                            <Button Grid.Column="1" Content="验证并连接" Click="ConfirmSecurityPinAndConnectClicked"
                                                    Style="{StaticResource CompactPrimaryButton}" MinHeight="40" Margin="10,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Action Bar Card -->
                                <Border Style="{StaticResource DashboardCard}" Padding="18,16">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <Button x:Name="ActionEngineLink" DockPanel.Dock="Right" Content="前往引擎中心 →"
                                                    Click="ShowEnginesPage" Style="{StaticResource InlineLinkButton}" Visibility="Collapsed" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="ActionEngineDot" Width="8" Height="8" Margin="0,0,8,0" Fill="{DynamicResource Ready}" />
                                                <TextBlock x:Name="ActionEngineHint" FontSize="12.5" Foreground="{DynamicResource Muted}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>

                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                                <Button x:Name="ConnectButton" Click="ConnectDevice" IsDefault="True"
                                                        Style="{StaticResource HeroConnectButton}" MinWidth="185"
                                                        AutomationProperties.AutomationId="ConnectDevice">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="ConnectButtonIcon" Text="&#xE945;" Style="{StaticResource Icon}"
                                                                   FontSize="15" Margin="0,0,8,0" />
                                                        <TextBlock x:Name="ConnectButtonText" Text="发起高刷连接" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="PairButton" Click="PairDevice" Style="{StaticResource QuietButton}"
                                                        MinHeight="44" Padding="16,10" Margin="10,0,0,0"
                                                        ToolTip="首次连接 Sunshine 被控端时用于配对 PIN 码"
                                                        AutomationProperties.AutomationId="PairDevice">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,7,0" />
                                                        <TextBlock Text="配对设备 (Pair)" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <TextBlock x:Name="ActionTargetSummary" DockPanel.Dock="Right" FontSize="12"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Remote Control Shortcut & Basic Operations Hints -->
                                <Border Style="{StaticResource SubPanelCard}" Padding="16,12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="远控操作与快捷键提示" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Ink}" Margin="0,0,0,8" />
                                        <WrapPanel>
                                            <Border Style="{StaticResource StatusPillBorder}" Background="{DynamicResource AccentSoft}" Margin="0,0,6,6">
                                                <TextBlock Text="办公自由默认不锁鼠" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource Accent}" />
                                            </Border>
                                            <Border Style="{StaticResource StatusPillBorder}" Margin="0,0,6,6">
                                                <TextBlock Text="Ctrl+Alt 释放锁鼠" FontSize="11.5" Foreground="{DynamicResource Ink}" />
                                            </Border>
                                            <Border Style="{StaticResource StatusPillBorder}" Margin="0,0,6,6">
                                                <TextBlock Text="Ctrl+Alt+G 切换模式" FontSize="11.5" Foreground="{DynamicResource Ink}" />
                                            </Border>
                                            <Border Style="{StaticResource StatusPillBorder}" Margin="0,0,6,6">
                                                <TextBlock Text="F11 全屏" FontSize="11.5" Foreground="{DynamicResource Ink}" />
                                            </Border>
                                            <Border Style="{StaticResource StatusPillBorder}" Margin="0,0,6,6">
                                                <TextBlock Text="Ctrl+Alt+Shift+Q 断开" FontSize="11.5" Foreground="{DynamicResource Ink}" />
                                            </Border>
                                            <Border Style="{StaticResource StatusPillBorder}" Margin="0,0,0,6">
                                                <TextBlock Text="Ctrl+Alt+H 帮助" FontSize="11.5" Foreground="{DynamicResource Ink}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="连接后默认鼠标可自由移出画面；在游戏锁定模式下按 Ctrl+Alt 可随时释放，拖拽文件到画面即可快传。"
                                                   FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 3. Inline Add / Edit Device Form -->
                            <Border x:Name="EditorView" Visibility="Collapsed" Style="{StaticResource DashboardCard}" Padding="22,20">
                                <StackPanel>
                                    <TextBlock x:Name="EditorTitle" Text="添加电脑" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock Text="填写目标主机的校园网 / 局域网地址或 EasyTier 虚拟内网 IP，保存后即可使用内置高刷窗口连接。"
                                               FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label x:Name="NameLabel" Target="{Binding ElementName=NameInput}" Content="电脑名称 *"
                                                   Foreground="{DynamicResource Muted}" Padding="0,0,0,5" />
                                            <TextBox x:Name="NameInput" MaxLength="40" Style="{StaticResource DeviceField}"
                                                     AutomationProperties.AutomationId="DeviceName"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label x:Name="HostLabel" Target="{Binding ElementName=HostAddressInput}"
                                                   Content="校园网 / 局域网 / 虚拟 IP 地址 *" Foreground="{DynamicResource Muted}" Padding="0,0,0,5" />
                                            <TextBox x:Name="HostAddressInput" MaxLength="253" Style="{StaticResource DeviceField}"
                                                     ToolTip="输入 IPv4、IPv6 或主机名，例如 10.126.126.2 或 192.168.31.88"
                                                     AutomationProperties.AutomationId="DeviceHostAddress"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=HostLabel}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label x:Name="AppNameLabel" Target="{Binding ElementName=StreamAppNameInput}"
                                                   Content="Sunshine 串流应用名" Foreground="{DynamicResource Muted}" Padding="0,0,0,5" />
                                            <TextBox x:Name="StreamAppNameInput" MaxLength="64" Style="{StaticResource DeviceField}"
                                                     Text="Desktop" AutomationProperties.AutomationId="StreamAppName"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=AppNameLabel}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource SubPanelCard}" VerticalAlignment="Bottom" MinHeight="40">
                                            <TextBlock Text="提示：默认 Desktop 会直接串流整个桌面；也可填写 Steam 等 Sunshine 应用名。"
                                                       FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="EditorMessage" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                               Margin="0,4,0,16" AutomationProperties.LiveSetting="Polite" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="RemoveButton" Content="移除电脑" Click="RequestRemoval"
                                                Foreground="{DynamicResource Danger}" Visibility="Collapsed"
                                                Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                                        <Button Content="取消" Click="CancelEdit" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                                        <Button x:Name="SaveDeviceButton" Content="保存电脑" Click="SaveDevice" IsDefault="True"
                                                Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="SaveDevice" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 4. Inline Removal Confirmation -->
                            <Border x:Name="RemovalView" Visibility="Collapsed" Style="{StaticResource DashboardCard}" Padding="24">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="20"
                                                   Foreground="{DynamicResource Danger}" Margin="0,0,10,0" />
                                        <TextBlock Text="移除这台电脑？" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="RemovalMessage" TextWrapping="Wrap" Margin="0,6,0,20" Foreground="{DynamicResource Muted}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="KeepDeviceButton" Content="保留电脑" Click="KeepDevice"
                                                Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                                        <Button Content="确认移除" Click="RemoveDevice" Background="{DynamicResource Danger}"
                                                Foreground="{DynamicResource DangerInk}" Style="{StaticResource PrimaryButton}"
                                                AutomationProperties.AutomationId="ConfirmRemoval" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- PAGE 2: 本机被控 -->
                <ScrollViewer x:Name="LocalHostPage" Grid.Row="1" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="20,4,20,18">
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform />
                    </ScrollViewer.RenderTransform>
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}" />
                    </ScrollViewer.Resources>

                    <StackPanel MaxWidth="1120">
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Click="RefreshHostStatusClicked" Style="{StaticResource QuietButton}"
                                    VerticalAlignment="Center" AutomationProperties.AutomationId="RefreshHostStatus">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="刷新状态" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="本机被控中心" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="管理当前电脑的 Sunshine 高刷被控端与协同桥接能力（剪贴板/文件/分辨率适配/防窥黑屏），查看校园网直连地址与显卡编码能力。"
                                           FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Background Daemon Service & Unattended Security Card -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="HostDaemonBadge" CornerRadius="11" Padding="10,4" Margin="0,0,10,0"
                                                Background="{DynamicResource SurfaceSubtle}">
                                            <TextBlock x:Name="HostDaemonBadgeText" Text="未安装" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Muted}" />
                                        </Border>
                                        <Button x:Name="ToggleDaemonServiceButton" Content="启用后台守护服务"
                                                Click="ToggleDaemonServiceClicked"
                                                Style="{StaticResource CompactPrimaryButton}" MinHeight="34"
                                                AutomationProperties.AutomationId="ToggleDaemonService" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource DeviceGlyph}" Width="44" Height="44" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="19" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="后台守护服务 (RemoteDeskAgent)" FontSize="15.5" FontWeight="SemiBold" />
                                            <TextBlock x:Name="HostDaemonDetailText"
                                                       Text="以系统权限后台常驻运行 EasyTier 与 Sunshine，彻底解决虚拟 IP 分配失败、免 UAC 弹窗且支持开机锁屏直连。"
                                                       FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <Border Height="1" Background="{DynamicResource Line}" Margin="0,2,0,12" />

                                <DockPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="HostSecurityPinToggle" DockPanel.Dock="Right"
                                              Style="{StaticResource ModernToggleSwitch}" Content="已关闭"
                                              VerticalAlignment="Center"
                                              Checked="HostSecurityPinToggled" Unchecked="HostSecurityPinToggled"
                                              AutomationProperties.AutomationId="HostSecurityPinToggle" />
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="可选：独立被控安全密码" FontSize="14.5" FontWeight="SemiBold" />
                                        <TextBlock Text="默认关闭（同账号免确认直连）；开启后，新设备首次自动配对本机需输入此安全密码。"
                                                   FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid x:Name="HostSecurityPinEditRow" Visibility="Collapsed" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="HostSecurityPinInput" Style="{StaticResource PasswordField}"
                                                 Padding="12,0,12,0"
                                                 AutomationProperties.AutomationId="HostSecurityPinInput" />
                                    <Button x:Name="SaveHostSecurityPinButton" Grid.Column="1" Content="保存安全密码"
                                            Click="SaveHostSecurityPinClicked"
                                            Style="{StaticResource CompactPrimaryButton}" MinHeight="40" Margin="10,0,0,0" />
                                </Grid>
                                <TextBlock x:Name="HostSunshineManagedText" FontSize="12" Foreground="{DynamicResource Ready}"
                                           Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="同账号默认开启零配置自动配对；无账号纯局域网首次配对也可直接在下方输入 4 位 PIN 码完成授权，无需打开 Sunshine 控制面板。" />
                            </StackPanel>
                        </Border>

                        <!-- Hero Switch & Service Control Card -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <CheckBox x:Name="HostModeToggle" DockPanel.Dock="Right" Style="{StaticResource ModernToggleSwitch}"
                                              Content="已开启" VerticalAlignment="Center"
                                              Checked="HostModeToggled" Unchecked="HostModeToggled"
                                              AutomationProperties.AutomationId="HostModeToggle" />
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource DeviceGlyph}" Width="46" Height="46" Margin="0,0,14,0">
                                            <TextBlock Text="&#xE977;" Style="{StaticResource Icon}" FontSize="22" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="允许本机被控" FontSize="17" FontWeight="Bold" />
                                            <TextBlock x:Name="HostModeDescription" Text="开启后可随时启停 Sunshine 高刷服务端，并支持远程协同、分辨率适配与防窥黑屏"
                                                       FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Host Engine Status Cards -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SubPanelCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <Border x:Name="HostSunshineBadge" DockPanel.Dock="Right" CornerRadius="6" Padding="8,2"
                                                        Background="{DynamicResource SurfaceSubtle}">
                                                    <TextBlock x:Name="HostSunshineBadgeText" Text="未安装" FontSize="11.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource Muted}" />
                                                </Border>
                                                <TextBlock Text="Sunshine 高刷被控端" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock x:Name="HostSunshinePathText" FontSize="12" Foreground="{DynamicResource Muted}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SubPanelCard}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <Border x:Name="HostBridgeBadge" DockPanel.Dock="Right" CornerRadius="6" Padding="8,2"
                                                        Background="{DynamicResource SurfaceSubtle}">
                                                    <TextBlock x:Name="HostBridgeBadgeText" Text="就绪" FontSize="11.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource Ready}" />
                                                </Border>
                                                <TextBlock Text="协同与防窥交互通道" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock x:Name="HostBridgeDetailText" FontSize="12" Foreground="{DynamicResource Muted}"
                                                       Text="支持双向剪贴板、文件直传、分辨率匹配、防窥黑屏与远程锁屏/电源控制。"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Host Control Buttons -->
                                <WrapPanel>
                                    <Button x:Name="StartSunshineButton" Click="StartSunshineClicked"
                                            Style="{StaticResource CompactPrimaryButton}" MinHeight="36" Margin="0,0,8,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="启动 Sunshine" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StopSunshineButton" Click="StopSunshineClicked"
                                            Style="{StaticResource CompactQuietButton}" MinHeight="36" Margin="0,0,8,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="停止 Sunshine" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="OpenSunshineUiButton" Click="OpenSunshineWebUiClicked"
                                            Style="{StaticResource CompactQuietButton}" MinHeight="36" Margin="0,0,8,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="打开 Sunshine 面板" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CopySunshineCredsButton" Click="CopySunshineCredsClicked"
                                            Style="{StaticResource CompactQuietButton}" MinHeight="36" Margin="0,0,8,6"
                                            ToolTip="仅在手动打开 Sunshine Web 控制台需要登录时使用；软件内远控无需此密码">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="复制面板密码" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="前往引擎中心" Click="ShowEnginesPage"
                                            Style="{StaticResource InlineLinkButton}" VerticalAlignment="Center" Margin="4,0,0,6" />
                                </WrapPanel>

                                <!-- In-App Offline LAN Quick PIN Approval -->
                                <Border Style="{StaticResource SubPanelCard}" Padding="14,10" Margin="0,10,0,0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="HostQuickPinInput" MaxLength="4" Width="108" Height="36"
                                                     Style="{StaticResource DeviceField}"
                                                     FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="14" FontWeight="SemiBold"
                                                     HorizontalContentAlignment="Center" Padding="8,0"
                                                     ToolTip="输入控制端提示的 4 位数字 PIN 码"
                                                     AutomationProperties.AutomationId="HostQuickPinInput" />
                                            <Button x:Name="SubmitHostQuickPinButton" Content="确认配对"
                                                    Click="SubmitHostQuickPinClicked"
                                                    Style="{StaticResource CompactPrimaryButton}" MinHeight="36" Margin="8,0,0,0"
                                                    AutomationProperties.AutomationId="SubmitHostQuickPin" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="局域网快捷配对（免开 Sunshine 面板）" FontSize="13.5" FontWeight="SemiBold" />
                                            <TextBlock Text="未登录同账号或纯局域网直连时，在此输入控制端显示的 4 位 PIN 码即可直接完成配对。"
                                                       FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Network & Hardware Info 2-Column Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Campus / LAN Direct Addresses -->
                            <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource ReadySoft}" CornerRadius="6" Padding="7,2">
                                            <TextBlock Text="零中转直连" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Ready}" />
                                        </Border>
                                        <TextBlock Text="本机校园网直连地址" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <Border Style="{StaticResource SubPanelCard}" Padding="12,9" Margin="0,0,0,12">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Click="BeginLocalHostRenameClicked" Style="{StaticResource CompactQuietButton}"
                                                            MinHeight="28" Padding="10,2" Margin="0,0,6,0" Content="重命名本机" />
                                                    <Button Click="CopyHostNameClicked" Style="{StaticResource CompactQuietButton}"
                                                            MinHeight="28" Padding="10,2" Content="复制" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="本机名称" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="本机" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="LocalDisplayNameText" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0" />
                                                    <TextBlock x:Name="LocalHostNameText" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Grid x:Name="LocalHostRenameRow" Visibility="Collapsed" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="LocalHostRenameInput" MaxLength="40" Style="{StaticResource DeviceField}"
                                                         KeyDown="LocalHostRenameInputKeyDown" />
                                                <Button x:Name="ConfirmLocalHostRenameButton" Grid.Column="1" Content="保存"
                                                        Click="ConfirmLocalHostRenameClicked" Style="{StaticResource CompactPrimaryButton}"
                                                        MinHeight="34" Margin="8,0,0,0" />
                                                <Button Grid.Column="2" Content="取消" Click="CancelLocalHostRenameClicked"
                                                        Style="{StaticResource CompactQuietButton}" MinHeight="34" Margin="6,0,0,0" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="IPv4 地址（局域网 / 校园网）" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                    <ItemsControl x:Name="LocalIpv4List" Margin="0,0,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SubPanelCard}" Padding="12,8" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Click="CopyAddressClicked" Tag="{Binding}"
                                                                Style="{StaticResource CompactQuietButton}" MinHeight="28" Padding="10,2" Content="复制" />
                                                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="LocalIpv4Empty" Text="未检测到活跃的局域网 / 校园网 IPv4 地址"
                                               FontSize="12" Foreground="{DynamicResource Muted}" Margin="2,0,0,12" Visibility="Collapsed" />

                                    <TextBlock Text="IPv6 地址（推荐跨寝室直连）" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                    <ItemsControl x:Name="LocalIpv6List">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SubPanelCard}" Padding="12,8" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Click="CopyAddressClicked" Tag="{Binding}"
                                                                Style="{StaticResource CompactQuietButton}" MinHeight="28" Padding="10,2" Content="复制" />
                                                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding}" Margin="0,0,8,0" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="LocalIpv6Empty" Text="当前网络未分配公网 / 校园网 IPv6 地址"
                                               FontSize="12" Foreground="{DynamicResource Muted}" Margin="2,0,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <!-- Right: GPU Hardware Encoders -->
                            <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource PurpleSoft}" CornerRadius="6" Padding="7,2">
                                            <TextBlock Text="硬件编解码" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PurpleAccent}" />
                                        </Border>
                                        <TextBlock Text="显卡硬件编码能力" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock Text="高刷被控端（Sunshine）将优先调用下方检测到的硬件视频编码引擎，实现低延迟高帧率推流。"
                                               FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14" />

                                    <ItemsControl x:Name="GpuEncodersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SubPanelCard}" Padding="13,10" Margin="0,0,0,8">
                                                    <DockPanel>
                                                        <Border x:Name="EncoderPill" DockPanel.Dock="Right" CornerRadius="6"
                                                                Padding="9,3" VerticalAlignment="Center"
                                                                Background="{DynamicResource ReadySoft}">
                                                            <TextBlock x:Name="EncoderPillText" Text="{Binding EncoderName}"
                                                                       FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Ready}" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding AdapterName}" FontWeight="SemiBold" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding AdapterName}" />
                                                            <TextBlock Text="{Binding Vendor}" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding EncoderName}" Value="QSV">
