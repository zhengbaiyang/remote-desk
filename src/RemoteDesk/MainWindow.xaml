                                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="启动组网" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StopEasyTierButton" Click="StopEasyTierClicked"
                                            Style="{StaticResource CompactQuietButton}" MinHeight="34" Margin="0,0,8,6"
