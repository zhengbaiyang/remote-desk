                                                           VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <DockPanel>
                                        <Button x:Name="SyncAuthSubmitButton" DockPanel.Dock="Right" Content="登录并自动组网"
