                                                           VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="账号用户名" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" />
                                            <Grid>
                                                <TextBox x:Name="SyncUsernameInput" Style="{StaticResource DeviceField}"
                                                         TextChanged="SyncAuthFieldChanged"
                                                         AutomationProperties.AutomationId="SyncUsernameInput" />
                                                <TextBlock x:Name="SyncUsernamePlaceholder" Text="3-32位字母数字或下划线"
                                                           Foreground="{DynamicResource Muted}" Opacity="0.58"
                                                           VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="账号密码" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" />
