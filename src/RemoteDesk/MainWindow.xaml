                                            <TextBlock Text="&#xE82D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="部署阿里云节点指南" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
