<Window x:Class="RemoteDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteDesk · 远程桌面" Width="1030" Height="630" MinWidth="760" MinHeight="550"
        WindowStartupLocation="CenterScreen" Background="#E9EEF2" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="59" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary Source="LightTheme.xaml" />
    </Window.Resources>

    <Grid Margin="10,4,10,10">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#DDE8EB" Offset="0" />
                <GradientStop Color="#EEF2F5" Offset="0.6" />
                <GradientStop Color="#E6EBF0" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62" />
            <ColumnDefinition Width="182" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border CornerRadius="17" BorderBrush="#252B31" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2E343B" Offset="0" />
                    <GradientStop Color="#171C21" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Top" Width="33" Height="33" Margin="0,14,0,13" CornerRadius="11" Background="#F2F7FA">
                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="17" Foreground="#263038" />
                </Border>
                <Border DockPanel.Dock="Top" Height="1" Width="30" Margin="0,0,0,12" Background="#49515A" />
                <Button x:Name="DevicesNav" DockPanel.Dock="Top" Click="ShowDevicesPage" Style="{StaticResource RailButton}"
                        Tag="Selected" ToolTip="我的电脑" AutomationProperties.Name="我的电脑" AutomationProperties.AutomationId="DevicesNav">
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="19" />
                </Button>
                <Button x:Name="SettingsNav" DockPanel.Dock="Bottom" Click="ShowSettingsPage" Style="{StaticResource RailButton}"
                        Margin="0,0,0,12" ToolTip="RustDesk 设置" AutomationProperties.Name="RustDesk 设置" AutomationProperties.AutomationId="SettingsNav">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="18" />
                </Button>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Margin="15,0,14,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Top" Text="RemoteDesk" FontSize="19" FontWeight="SemiBold" Margin="3,21,0,30" />
            <TextBlock DockPanel.Dock="Top" Text="已保存的设备" Foreground="{StaticResource Muted}" FontSize="12" Margin="4,0,0,8" />
            <Button x:Name="SidebarDevice" DockPanel.Dock="Top" Click="ShowDevicesPage" Style="{StaticResource SidebarDeviceButton}"
                    Tag="Selected" Visibility="Collapsed" AutomationProperties.AutomationId="SidebarDevice">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Left" />
                    <TextBlock x:Name="SidebarName" Grid.Column="1" Margin="5,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="9" Foreground="{StaticResource Muted}" />
                </Grid>
            </Button>
            <TextBlock x:Name="SidebarEmpty" DockPanel.Dock="Top" Text="暂无设备" Foreground="{StaticResource Muted}" Margin="4,9,0,0" />
            <Button DockPanel.Dock="Bottom" Click="ShowSettingsPage" Style="{StaticResource SideButton}" Margin="0,0,0,10"
                    ToolTip="查看本机 RustDesk 设置" AutomationProperties.AutomationId="ClientSettings"
                    AutomationProperties.Name="查看本机 RustDesk 设置">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ClientDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="ClientStatus" FontSize="12" FontWeight="Normal" Foreground="{StaticResource Muted}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Button>
        </DockPanel>

        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#DCE3E9" BorderThickness="1" CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="57" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,0,7,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeWindow"
                                    AutomationProperties.Name="最小化" ToolTip="最小化" />
                            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                                    Click="ToggleMaximized" AutomationProperties.Name="最大化" ToolTip="最大化" />
                            <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="CloseWindow"
                                    AutomationProperties.Name="关闭窗口" ToolTip="关闭窗口" />
                        </StackPanel>
                        <TextBlock x:Name="CurrentPage" Text="我的电脑" FontWeight="SemiBold" FontSize="22" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="27,25,27,25" MaxWidth="950">
                        <Grid>
                            <StackPanel x:Name="DevicePage">


                                <Border x:Name="EmptyView" MinHeight="217" Padding="22" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="19" Background="{StaticResource Card}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="54" Height="54" CornerRadius="17" Background="#E5EDF5" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="24" Foreground="#334C64" />
                                        </Border>
                                        <TextBlock Text="还没有保存的电脑" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,3" />
                                        <TextBlock Text="在目标电脑的 RustDesk 首页可以找到设备 ID。" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                        <Button x:Name="AddDeviceButton" Content="添加电脑" Click="EditDevice" IsDefault="True" Margin="0,15,0,0"
                                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" AutomationProperties.AutomationId="AddDevice" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="DeviceView" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="19" Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="142" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="15" MinHeight="157">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#E6F1F9" Offset="0" />
                                                    <GradientStop Color="#DAE8F6" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border Width="66" Height="66" CornerRadius="19" Background="#F5FAFE" BorderBrush="#FFFFFF" BorderThickness="1">
                                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="34" Foreground="#375772" />
                                            </Border>
                                        </Border>
                                        <Grid Grid.Column="1" Margin="20,5,2,4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="DeviceNameText" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                <TextBlock x:Name="DeviceIdText" Margin="0,7,0,10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="编辑" Click="EditDevice" Style="{StaticResource QuietButton}" Margin="0,0,9,0"
                                                        MinWidth="64" AutomationProperties.Name="编辑电脑" AutomationProperties.AutomationId="EditDevice" />
                                                <Button x:Name="ConnectButton" Click="ConnectDevice" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="100"
                                                        AutomationProperties.Name="连接" AutomationProperties.AutomationId="ConnectDevice">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="连接" VerticalAlignment="Center" />
                                                        <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="13" Margin="9,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border x:Name="RemovalView" Visibility="Collapsed" Padding="19,16" CornerRadius="19"
                                        Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="移除这台电脑？" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock x:Name="RemovalMessage" TextWrapping="Wrap" Margin="0,12,0,20" Foreground="{StaticResource Muted}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="KeepDeviceButton" Content="保留电脑" Click="KeepDevice" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                                            <Button Content="确认移除" Click="RemoveDevice" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="ConfirmRemoval" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="EditorView" Visibility="Collapsed" Padding="19,16" CornerRadius="19" Background="{StaticResource Card}"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="EditorTitle" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,9" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Label x:Name="NameLabel" Target="{Binding ElementName=NameInput}" Content="电脑名称" Foreground="{StaticResource Muted}" Padding="0,4" />
                                                <TextBox x:Name="NameInput" AutomationProperties.AutomationId="DeviceName" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"
                                                         MaxLength="40" Style="{StaticResource DeviceField}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Label x:Name="IdLabel" Target="{Binding ElementName=IdInput}" Content="RustDesk 设备 ID" Foreground="{StaticResource Muted}" Padding="0,4" />
                                                <TextBox x:Name="IdInput" AutomationProperties.AutomationId="DeviceId" AutomationProperties.LabeledBy="{Binding ElementName=IdLabel}"
                                                         MaxLength="64" Style="{StaticResource DeviceField}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="EditorMessage" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,9,0,10" AutomationProperties.LiveSetting="Polite" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="RemoveButton" Content="移除电脑" Click="RequestRemoval" Foreground="#9A393D"
                                                    Visibility="Collapsed" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                                            <Button Content="取消" Click="CancelEdit" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                                            <Button x:Name="SaveDeviceButton" Content="保存电脑" Click="SaveDevice" IsDefault="True" Style="{StaticResource PrimaryButton}"
                                                    AutomationProperties.AutomationId="SaveDevice" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ConnectionTip" Margin="0,18,0,0" Padding="18,14" CornerRadius="15"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="连接准备" FontSize="16" FontWeight="SemiBold" />
                                        <DockPanel Margin="0,12,0,12">
                                            <Button DockPanel.Dock="Right" Content="配置客户端" Click="ShowSettingsPage" Margin="12,0,0,0"
                                                    Style="{StaticResource QuietButton}" AutomationProperties.AutomationId="ConfigureClient" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="本机客户端" FontWeight="SemiBold" />
                                                <TextBlock x:Name="LocalClientHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="目标电脑" FontWeight="SemiBold" />
                                                <TextBlock Text="保持电脑唤醒并运行 RustDesk。无人值守时，先在目标端设置固定密码。"
                                                           Margin="0,3,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="SettingsPage" Visibility="Collapsed">

                                <TextBlock Text="查看或更换用于发起远程会话的本机程序。" Margin="1,5,0,18" Foreground="{StaticResource Muted}" />
                                <Border CornerRadius="19" Padding="19" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="RustDesk 客户端" FontWeight="SemiBold" FontSize="18" />
                                        <TextBlock x:Name="ClientPathText" Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="官方下载" Click="OpenRustDeskDownload" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                                            <Button x:Name="SelectClientButton" Content="选择程序" Click="SelectRustDesk" Style="{StaticResource PrimaryButton}"
                                                    AutomationProperties.AutomationId="SelectClient" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="StatusMessage" Margin="2,14,2,0" TextWrapping="Wrap"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
