                                    <DockPanel>
                                        <Button x:Name="FixEasyTierElevationButton" DockPanel.Dock="Right" Content="一键启用守护服务修复"
                                                Click="ToggleDaemonServiceClicked" Style="{StaticResource CompactPrimaryButton}"
                                                MinHeight="32" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="检测到 EasyTier 未获得创建虚拟网卡权限（导致一直等待分配 IP）"
                                                       FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Warning}" />
                                            <TextBlock Text="Windows 分配 Wintun 虚拟 IP 需要系统服务或管理员权限。点击右侧按钮启用后台守护服务即可彻底解决。"
