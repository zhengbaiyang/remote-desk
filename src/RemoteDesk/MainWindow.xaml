                                                       FontWeight="Bold" Foreground="{DynamicResource Muted}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="18"
                                                   Foreground="{DynamicResource Accent}" Margin="0,0,10,0" />
                                        <TextBlock Text="EasyTier P2P 跨网组网" FontSize="16.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

