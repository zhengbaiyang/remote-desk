<Window x:Class="RemoteDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteDesk · 远程桌面" Icon="Assets/remotedesk.ico" Width="1080" Height="610" MinWidth="760" MinHeight="550"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowSurface}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="12" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LightTheme.xaml" />
                <ResourceDictionary Source="GlassControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,0,6,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Click="ToggleTheme" Style="{StaticResource CaptionButton}" Margin="0,0,6,0" />
                    <Border Background="{DynamicResource Line}" Width="1" Height="16" Margin="0,0,5,0" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeWindow"
                            AutomationProperties.Name="最小化" ToolTip="最小化" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="ToggleMaximized"
                            AutomationProperties.Name="最大化" ToolTip="最大化" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="CloseWindow"
                            AutomationProperties.Name="关闭窗口" ToolTip="关闭窗口" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/remotedesk.png" Width="25" Height="25" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="RemoteDesk" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16" MaxWidth="1480">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource GlassRail}" CornerRadius="20" Padding="9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,9">
                        <Button x:Name="AddFromListButton" DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}"
                                Click="AddDevice" Content="&#xE710;" ToolTip="添加电脑" AutomationProperties.Name="添加电脑"
                                AutomationProperties.AutomationId="AddFromList" />
                        <Button x:Name="DevicesNav" Style="{StaticResource ListNavigation}" Click="ShowDevicesPage" Tag="Selected">
                            <DockPanel>
                                <TextBlock x:Name="DeviceCount" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                <TextBlock Text="我的电脑" FontWeight="Bold" FontSize="14" />
                            </DockPanel>
                        </Button>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="DeviceList" SelectionChanged="DeviceSelectionChanged"
                                 Style="{StaticResource SavedDeviceList}" ItemContainerStyle="{StaticResource SavedDeviceRow}"
                                 AutomationProperties.Name="已保存的电脑">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource Glyph}" CornerRadius="9" Width="30" Height="30"
                                                VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Foreground="{DynamicResource Ready}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" />
                                            <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Id}" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="DeviceListEmpty" Text="还没有设备" Foreground="{DynamicResource Muted}" Margin="10,11,0,0"
                                   VerticalAlignment="Top" IsHitTestVisible="False" />
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                        <Button x:Name="SettingsNav" Click="ShowSettingsPage" Style="{StaticResource ListNavigation}"
                                AutomationProperties.Name="设置">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,9,0" />
                                <TextBlock Text="设置" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource GlassFrame}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,15,20,15">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Click="ShowSettingsPage" Style="{StaticResource QuietButton}"
                                    VerticalAlignment="Center" AutomationProperties.AutomationId="ClientSettings"
                                    ToolTip="查看本机 RustDesk 设置">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ClientDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock x:Name="ClientStatus" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="CurrentPage" Text="设备详情" FontWeight="Bold" FontSize="23" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" Margin="8,0,5,9" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}" />
                        </ScrollViewer.Resources>
                        <StackPanel Margin="15,18,17,16" MaxWidth="1150">
                            <Grid>
                                <Grid x:Name="DevicePage">
                                    <Border x:Name="EmptyView" Style="{StaticResource GlassCard}" MinHeight="244">
                                        <StackPanel VerticalAlignment="Center">
                                            <Border Style="{StaticResource DeviceGlyph}">
                                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="29" />
                                            </Border>
                                            <TextBlock Text="还没有保存的电脑" FontSize="23" FontWeight="Bold" Margin="0,14,0,4" />
                                            <TextBlock Text="在目标电脑的 RustDesk 首页查看设备 ID。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                                            <Button x:Name="AddDeviceButton" Content="添加电脑" Click="AddDevice" IsDefault="True" Margin="0,18,0,0"
                                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" AutomationProperties.AutomationId="AddDevice" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="DeviceView" Visibility="Collapsed" Style="{StaticResource GlassCard}" MinHeight="244">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Style="{StaticResource DeviceGlyph}">
                                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="29" />
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="0,14,0,18">
                                                <TextBlock x:Name="DeviceNameText" FontSize="27" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                <TextBlock x:Name="DeviceIdText" Margin="0,6,0,0" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                <Button x:Name="ConnectButton" Click="ConnectDevice" IsDefault="True" Style="{StaticResource PrimaryButton}"
                                                        MinWidth="110" AutomationProperties.Name="连接" AutomationProperties.AutomationId="ConnectDevice">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="连接" VerticalAlignment="Center" />
                                                        <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="13" Margin="10,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="编辑" Click="EditDevice" Style="{StaticResource QuietButton}" Margin="8,0,0,0"
                                                        AutomationProperties.Name="编辑电脑" AutomationProperties.AutomationId="EditDevice" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="RemovalView" Visibility="Collapsed" Style="{StaticResource GlassCard}">
                                        <StackPanel>
                                            <TextBlock Text="移除这台电脑？" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock x:Name="RemovalMessage" TextWrapping="Wrap" Margin="0,12,0,20" Foreground="{DynamicResource Muted}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="KeepDeviceButton" Content="保留电脑" Click="KeepDevice" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                                                <Button Content="确认移除" Click="RemoveDevice" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="ConfirmRemoval" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="EditorView" Visibility="Collapsed" Style="{StaticResource GlassCard}">
                                        <StackPanel>
                                            <TextBlock x:Name="EditorTitle" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,9" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <Label x:Name="NameLabel" Target="{Binding ElementName=NameInput}" Content="电脑名称" Foreground="{DynamicResource Muted}" Padding="0,4" />
                                                    <TextBox x:Name="NameInput" AutomationProperties.AutomationId="DeviceName" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"
                                                             MaxLength="40" Style="{StaticResource DeviceField}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <Label x:Name="IdLabel" Target="{Binding ElementName=IdInput}" Content="RustDesk 设备 ID" Foreground="{DynamicResource Muted}" Padding="0,4" />
                                                    <TextBox x:Name="IdInput" AutomationProperties.AutomationId="DeviceId" AutomationProperties.LabeledBy="{Binding ElementName=IdLabel}"
                                                             MaxLength="64" Style="{StaticResource DeviceField}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="EditorMessage" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,9,0,10" AutomationProperties.LiveSetting="Polite" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="RemoveButton" Content="移除电脑" Click="RequestRemoval" Foreground="{DynamicResource Danger}"
                                                        Visibility="Collapsed" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                                                <Button Content="取消" Click="CancelEdit" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                                                <Button x:Name="SaveDeviceButton" Content="保存电脑" Click="SaveDevice" IsDefault="True" Style="{StaticResource PrimaryButton}"
                                                        AutomationProperties.AutomationId="SaveDevice" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel x:Name="SettingsPage" Visibility="Collapsed">

                                    <Border Style="{StaticResource GlassCard}">
                                        <StackPanel>
                                            <TextBlock Text="RustDesk 客户端" FontWeight="SemiBold" FontSize="18" />
                                            <TextBlock x:Name="ClientPathText" Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="官方下载" Click="OpenRustDeskDownload" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                                                <Button x:Name="SelectClientButton" Content="选择便携版" Click="SelectRustDesk" Style="{StaticResource QuietButton}" Margin="0,0,8,0"
                                                        AutomationProperties.AutomationId="SelectClient" />
                                                <Button x:Name="RescanButton" Content="重新检测" Click="RescanClient" Style="{StaticResource PrimaryButton}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="AppVersion" FontWeight="SemiBold" FontSize="18" />
                                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Margin="0,6,0,12" Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite" />
                                            <Button x:Name="UpdateButton" Content="检查更新" Click="UpdateClicked" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="StatusMessage" Margin="2,14,2,0" TextWrapping="Wrap"
                                       Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
