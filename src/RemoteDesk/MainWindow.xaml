                                                AutomationProperties.AutomationId="SyncAuthSubmitButton" />
                                        <Button x:Name="ResetTlsTrustButton" DockPanel.Dock="Left" Content="重置服务器证书信任"
                                                Click="ResetTlsTrustClicked" Style="{StaticResource CompactQuietButton}"
                                                MinHeight="34" Visibility="Collapsed" />
                                    </DockPanel>
                                </StackPanel>

                                <!-- Logged-In Profile & Sync Actions -->
                                <StackPanel x:Name="AccountLoggedInPanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SubPanelCard}" Padding="12,9">
                                            <StackPanel>
                                                <TextBlock Text="当前登录账号" FontSize="11" Foreground="{DynamicResource Muted}" />
                                                <TextBlock x:Name="AccountProfileNameText" FontSize="14" FontWeight="Bold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource SubPanelCard}" Padding="12,9">
                                            <StackPanel>
                                                <TextBlock Text="云端分配固定虚拟 IP" FontSize="11" Foreground="{DynamicResource Muted}" />
                                                <TextBlock x:Name="AccountVirtualIpText" FontSize="14" FontWeight="Bold"
                                                           FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{DynamicResource Accent}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource SubPanelCard}" Padding="12,9">
                                            <StackPanel>
                                                <TextBlock Text="隔离私有网络 / 同步服务器" FontSize="11" Foreground="{DynamicResource Muted}" />
                                                <TextBlock x:Name="AccountNetworkNameText" FontSize="12.5" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="AccountServerText" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <WrapPanel>
