                                                Click="ToggleDaemonServiceClicked" Style="{StaticResource CompactQuietButton}"
                                                MinHeight="34" Margin="0,0,8,4" />
                                        <Button x:Name="LogoutAccountButton" Content="退出账号" Click="LogoutAccountClicked"
                                                Style="{StaticResource CompactQuietButton}" Foreground="{DynamicResource Danger}"
                                                MinHeight="34" Margin="0,0,0,4" />
                                    </WrapPanel>
                                </StackPanel>

                                <TextBlock x:Name="SyncAccountFeedback" FontSize="12" Foreground="{DynamicResource Muted}"
                                           TextWrapping="Wrap" Margin="2,10,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Compact Campus / LAN Direct Summary Strip -->
                        <Border Style="{StaticResource DashboardCard}" Padding="16,12" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource ReadySoft}"
                                            CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="校园网 / 局域网直连（零服务器）" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Ready}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="15"
                                                   Foreground="{DynamicResource Ready}" Margin="0,0,8,0" />
                                        <TextBlock Text="本机局域网直连概览" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SubPanelCard}" Padding="11,8">
                                        <StackPanel>
                                            <TextBlock Text="本机主机名" FontSize="11" Foreground="{DynamicResource Muted}" />
                                            <TextBlock x:Name="NetPageHostName" FontSize="13.5" FontWeight="Bold" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SubPanelCard}" Padding="11,8">
                                        <StackPanel>
                                            <TextBlock Text="首选 IPv4" FontSize="11" Foreground="{DynamicResource Muted}" />
                                            <TextBlock x:Name="NetPagePrimaryIpv4" FontSize="13.5" FontWeight="Bold"
                                                       FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{DynamicResource Accent}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource SubPanelCard}" Padding="11,8">
                                        <StackPanel>
                                            <TextBlock Text="首选 IPv6" FontSize="11" Foreground="{DynamicResource Muted}" />
                                            <TextBlock x:Name="NetPagePrimaryIpv6" FontSize="12.5" FontWeight="SemiBold"
                                                       FontFamily="Cascadia Mono, Consolas, Segoe UI" Foreground="{DynamicResource Ready}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

