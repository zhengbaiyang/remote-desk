                                        <Grid>
                                            <TextBox x:Name="EasyTierVirtualIpv4Input" Style="{StaticResource DeviceField}"
                                                     TextChanged="EasyTierFieldTextChanged"
                                                     AutomationProperties.AutomationId="EasyTierVirtualIpv4Input" />
                                            <TextBlock x:Name="EasyTierVirtualIpv4Placeholder" Text="例如：10.126.126.1/24"
                                                       Foreground="{DynamicResource Muted}" Opacity="0.58"
                                                       VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Toggles & Save Row -->
                                <DockPanel>
                                    <Button x:Name="SaveEasyTierConfigButton" DockPanel.Dock="Right" Content="保存配置"
                                            Click="SaveEasyTierConfigClicked" Style="{StaticResource CompactPrimaryButton}"
                                            MinHeight="34" VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="SaveEasyTierConfig" />
                                    <WrapPanel VerticalAlignment="Center">
                                        <CheckBox x:Name="EasyTierAutoAssignToggle" Style="{StaticResource ModernToggleSwitch}"
                                                  Content="自动分配虚拟 IP" IsChecked="True" Margin="0,0,22,4"
                                                  Checked="EasyTierAutoAssignToggled" Unchecked="EasyTierAutoAssignToggled"
                                                  AutomationProperties.AutomationId="EasyTierAutoAssignToggle" />
                                        <CheckBox x:Name="EasyTierAutoStartToggle" Style="{StaticResource ModernToggleSwitch}"
                                                  Content="启动软件时自动组网" Margin="0,0,12,4"
                                                  AutomationProperties.AutomationId="EasyTierAutoStartToggle" />
                                    </WrapPanel>
                                </DockPanel>

                                <TextBlock x:Name="EasyTierConfigFeedback" FontSize="12" Foreground="{DynamicResource Muted}"
                                           TextWrapping="Wrap" Margin="2,8,0,0" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- Online Mesh Peers Card -->
                        <Border Style="{StaticResource DashboardCard}" Padding="18,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource StatusPillBorder}" Padding="8,2">
                                        <TextBlock x:Name="EasyTierPeerCountText" Text="0 个节点" FontSize="11.5"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE839;" Style="{StaticResource Icon}" FontSize="16"
                                                   Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
                                        <TextBlock Text="在线组网节点" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl x:Name="EasyTierPeersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SubPanelCard}" Padding="13,10" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border x:Name="ConnBadge" CornerRadius="6" Padding="8,3" Margin="0,0,8,0"
                                                                VerticalAlignment="Center" Background="{DynamicResource SurfaceSubtle}">
                                                            <TextBlock x:Name="ConnBadgeText" Text="{Binding ConnectionType}"
                                                                       FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Muted}" />
                                                        </Border>
                                                        <Border Style="{StaticResource StatusPillBorder}" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LatencyText}" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                                       FontSize="11.5" Foreground="{DynamicResource Ink}" />
                                                        </Border>
                                                        <Border Style="{StaticResource StatusPillBorder}" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ProtocolText}" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                                       FontSize="11.5" Foreground="{DynamicResource Muted}" />
                                                        </Border>
                                                        <Button Content="添加到设备" Click="AddPeerAsDeviceClicked" Tag="{Binding}"
                                                                Style="{StaticResource CompactPrimaryButton}" MinHeight="30" Padding="11,4"
                                                                Visibility="{Binding CanAddAsDevice, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="已加入 · 查看" Click="ViewExistingPeerDeviceClicked" Tag="{Binding}"
                                                                Style="{StaticResource CompactQuietButton}" MinHeight="30" Padding="11,4"
                                                                Visibility="{Binding IsAlreadyAdded, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>

                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayHostname}" FontWeight="SemiBold" FontSize="13.5"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding IsSelf, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="本机" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DisplayVirtualIpv4}" FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                                   FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding ConnectionTone}" Value="P2P">
                                                    <Setter TargetName="ConnBadge" Property="Background" Value="{DynamicResource ReadySoft}" />
                                                    <Setter TargetName="ConnBadgeText" Property="Foreground" Value="{DynamicResource Ready}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConnectionTone}" Value="Relay">
                                                    <Setter TargetName="ConnBadge" Property="Background" Value="{DynamicResource WarningSoft}" />
                                                    <Setter TargetName="ConnBadgeText" Property="Foreground" Value="{DynamicResource Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConnectionTone}" Value="Self">
                                                    <Setter TargetName="ConnBadge" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                    <Setter TargetName="ConnBadgeText" Property="Foreground" Value="{DynamicResource Accent}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border x:Name="EasyTierPeersEmptyCard" Style="{StaticResource SubPanelCard}" Padding="16,14">
                                    <DockPanel>
                                        <Button x:Name="EasyTierEmptyEnginesButton" DockPanel.Dock="Right" Content="前往引擎与设置"
                                                Click="ShowEnginesPage" Style="{StaticResource CompactQuietButton}"
                                                VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="EasyTierEmptyTitle" Text="尚未加入 EasyTier 虚拟网络" FontWeight="SemiBold" FontSize="13.5" />
                                            <TextBlock x:Name="EasyTierEmptySubtitle" Text="请先在「引擎与设置」一键安装 EasyTier，并在上方填写网络名称、密钥与节点地址后点击「启动组网」。"
                                                       FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PAGE 4: 引擎与设置 -->
                <ScrollViewer x:Name="EnginesSettingsPage" Grid.Row="1" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="20,4,20,18">
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform />
                    </ScrollViewer.RenderTransform>
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}" />
                    </ScrollViewer.Resources>

                    <StackPanel MaxWidth="1120">
                        <DockPanel Margin="0,0,0,14">
                            <Button x:Name="RescanAllEnginesButton" DockPanel.Dock="Right" Click="RescanAllEnginesClicked"
                                    Style="{StaticResource PrimaryButton}" MinHeight="38" Padding="16,6" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="RescanAllEngines">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,7,0" />
                                    <TextBlock Text="重新检测全部引擎" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="托管式引擎中心与设置" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="一键拉取或导入开源便携引擎至本地托管目录，与系统环境隔离，随时升级或卸载。"
                                           FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Managed Engine Hub Cards -->
                        <ItemsControl x:Name="EngineCardsList" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DashboardCard}" Padding="18,14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <!-- Install State Pill -->
                                                <Border x:Name="StateBadge" DockPanel.Dock="Right" CornerRadius="7" Padding="10,3"
                                                        VerticalAlignment="Center" Background="{DynamicResource SurfaceSubtle}">
                                                    <TextBlock x:Name="StateBadgeText" Text="{Binding StateLabel}" FontSize="11.5"
                                                               FontWeight="Bold" Foreground="{DynamicResource Muted}" />
                                                </Border>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="5" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RoleTag}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource SurfaceSubtle}" BorderBrush="{DynamicResource CardBorder}"
                                                            BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding License}" FontSize="10.5" Foreground="{DynamicResource Muted}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding VersionLabel}" FontSize="11.5" Foreground="{DynamicResource Muted}"
                                                               Margin="9,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding HasVersion, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </DockPanel>

                                            <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource Muted}"
                                                       TextWrapping="Wrap" Margin="0,0,0,6" />

                                            <TextBlock Text="{Binding DetailPathText}" FontSize="11.5"
                                                       FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                                       Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DetailPathText}" Margin="0,0,0,10" />

                                            <!-- Progress Bar while Installing -->
                                            <StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                                <DockPanel Margin="0,0,0,5">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercentText}"
                                                               FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                                                    <TextBlock Text="{Binding ProgressStageText}" FontSize="11.5" Foreground="{DynamicResource Ink}" />
                                                </DockPanel>
                                                <ProgressBar Style="{StaticResource ModernProgressBar}" Minimum="0" Maximum="100"
                                                             Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
                                            </StackPanel>

                                            <!-- Active Phase 1 Engine Actions -->
                                            <WrapPanel Visibility="{Binding IsPhase1Engine, Converter={StaticResource BoolToVis}}">
                                                <Button Content="一键安装" Click="InstallEngineFromGitHubClicked" Tag="{Binding Kind}"
                                                        IsEnabled="{Binding CanStartInstall}"
                                                        Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,4" />
                                                <Button Content="导入本地包" Click="ImportEngineLocalClicked" Tag="{Binding Kind}"
                                                        IsEnabled="{Binding CanStartInstall}"
                                                        Style="{StaticResource CompactQuietButton}" Margin="0,0,8,4" />
                                                <Button Content="指定路径" Click="SelectEnginePathClicked" Tag="{Binding Kind}"
                                                        IsEnabled="{Binding CanStartInstall}"
                                                        Style="{StaticResource CompactQuietButton}" Margin="0,0,8,4" />
                                                <Button Content="卸载托管" Click="UninstallEngineClicked" Tag="{Binding Kind}"
                                                        IsEnabled="{Binding CanUninstall}" Foreground="{DynamicResource Danger}"
                                                        Style="{StaticResource CompactQuietButton}" Margin="0,0,8,4" />
                                                <Button Content="发布页" Click="OpenEngineReleasesClicked" Tag="{Binding Kind}"
                                                        Style="{StaticResource CompactQuietButton}" Margin="0,0,0,4" />
                                            </WrapPanel>

                                            <!-- Phase 2 Placeholder Actions (EasyTier) -->
                                            <WrapPanel Visibility="{Binding IsPhase2Placeholder, Converter={StaticResource BoolToVis}}">
                                                <Button Content="阶段 2 即将上线" IsEnabled="False"
                                                        Style="{StaticResource CompactQuietButton}" Margin="0,0,8,4" />
                                                <Button Content="发布页" Click="OpenEngineReleasesClicked" Tag="{Binding Kind}"
                                                        Style="{StaticResource CompactQuietButton}" Margin="0,0,0,4" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding StateKey}" Value="ManagedInstalled">
                                            <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource ReadySoft}" />
                                            <Setter TargetName="StateBadgeText" Property="Foreground" Value="{DynamicResource Ready}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKey}" Value="SystemInstalled">
                                            <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter TargetName="StateBadgeText" Property="Foreground" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKey}" Value="Installing">
                                            <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource WarningSoft}" />
                                            <Setter TargetName="StateBadgeText" Property="Foreground" Value="{DynamicResource Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKey}" Value="PlannedPhase2">
                                            <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource PurpleSoft}" />
                                            <Setter TargetName="StateBadgeText" Property="Foreground" Value="{DynamicResource PurpleAccent}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Download Mirror Acceleration Settings -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,4,0,12">
                            <StackPanel>
                                <TextBlock Text="国内镜像加速设置" FontSize="15.5" FontWeight="Bold" />
                                <TextBlock Text="为 GitHub 开源引擎与软件更新安装包下载配置 HTTPS 镜像前缀（例如 https://gh-proxy.com/）。若镜像失败将自动回退直连 GitHub。"
                                           FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="MirrorPrefixInput" Style="{StaticResource DeviceField}"
                                                 TextChanged="MirrorPrefixInputChanged"
                                                 AutomationProperties.AutomationId="MirrorPrefixInput" />
                                        <TextBlock x:Name="MirrorPlaceholder" Text="例如：https://gh-proxy.com/"
                                                   Foreground="{DynamicResource Muted}" Opacity="0.6"
                                                   VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                                    </Grid>
                                    <Button Grid.Column="1" Content="保存镜像" Click="SaveMirrorClicked"
                                            Style="{StaticResource PrimaryButton}" MinHeight="40" Margin="10,0,0,0" />
                                    <Button Grid.Column="2" Content="清空" Click="ClearMirrorClicked"
                                            Style="{StaticResource QuietButton}" MinHeight="40" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock x:Name="MirrorFeedbackText" FontSize="12" Foreground="{DynamicResource Muted}"
                                           Margin="2,8,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- Appearance Toggle Card -->
                        <Border Style="{StaticResource DashboardCard}" Padding="18,14" Margin="0,0,0,12">
                            <DockPanel>
                                <CheckBox x:Name="SettingsThemeToggle" DockPanel.Dock="Right"
                                          Style="{StaticResource ModernToggleSwitch}" Content="浅色模式"
                                          VerticalAlignment="Center"
                                          Checked="SettingsThemeToggled" Unchecked="SettingsThemeToggled" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="界面外观" FontSize="15.5" FontWeight="SemiBold" />
                                    <TextBlock Text="在柔和浅色与 macOS 石墨深色外观间切换。"
                                               FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Upgraded Auto-Update Card (GitHub Release + Velopack + Mirror Acceleration) -->
                        <Border Style="{StaticResource DashboardCard}" Padding="18,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="UpdateButton" Content="检查更新" Click="UpdateClicked"
                                                Style="{StaticResource CompactPrimaryButton}" MinHeight="34" Margin="0,0,8,0"
                                                AutomationProperties.AutomationId="CheckUpdates" />
                                        <Button x:Name="OpenReleasePageButton" Content="打开发布页" Click="OpenUpdateReleasePageClicked"
                                                Style="{StaticResource CompactQuietButton}" MinHeight="34" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="AppVersion" FontWeight="Bold" FontSize="15.5" VerticalAlignment="Center" />
                                        <Border x:Name="UpdateModeBadge" Background="{DynamicResource AccentSoft}"
                                                CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="UpdateModeBadgeText" Text="直连 Release 更新" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="自动更新仓库源（支持 owner/repo 或 https://github.com/owner/repo）"
                                           FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="UpdateRepoInput" Style="{StaticResource DeviceField}"
                                                 TextChanged="UpdateRepoInputChanged"
                                                 AutomationProperties.AutomationId="UpdateRepoInput" />
                                        <TextBlock x:Name="UpdateRepoPlaceholder" Text="zhengbaiyang/remote-desk"
                                                   Foreground="{DynamicResource Muted}" Opacity="0.6"
                                                   VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                                    </Grid>
                                    <Button Grid.Column="1" x:Name="SaveUpdateRepoButton" Content="保存仓库"
                                            Click="SaveUpdateRepoClicked" Style="{StaticResource CompactQuietButton}"
                                            MinHeight="40" Margin="10,0,0,0" />
                                    <Button Grid.Column="2" x:Name="ResetUpdateRepoButton" Content="恢复默认"
                                            Click="ResetUpdateRepoClicked" Style="{StaticResource CompactQuietButton}"
                                            MinHeight="40" Margin="8,0,0,0" />
                                </Grid>

                                <TextBlock x:Name="UpdateRepoFeedback" FontSize="12" Foreground="{DynamicResource Muted}"
                                           Margin="2,0,0,6" Visibility="Collapsed" />

                                <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Margin="2,4,0,0" FontSize="12.5"
                                           Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite" />

                                <!-- Update Download Progress -->
                                <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock x:Name="UpdateProgressPercentText" DockPanel.Dock="Right"
                                                   FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                                        <TextBlock x:Name="UpdateProgressStageText" FontSize="11.5" Foreground="{DynamicResource Ink}" />
                                    </DockPanel>
                                    <ProgressBar x:Name="UpdateProgressBar" Style="{StaticResource ModernProgressBar}"
                                                 Minimum="0" Maximum="100" />
                                </StackPanel>

                                <!-- Latest Release Notes Summary -->
                                <Border x:Name="UpdateReleaseNotesBorder" Style="{StaticResource SubPanelCard}"
                                        Padding="13,10" Margin="0,10,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="UpdateReleaseTitle" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock x:Name="UpdateReleaseNotesText" FontSize="12" Foreground="{DynamicResource Muted}"
                                                   TextWrapping="Wrap" MaxHeight="110" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Global Inline Status Banner -->
                <Border x:Name="StatusBanner" Grid.Row="2" Visibility="Collapsed"
                        Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,1,0,0" Padding="18,9">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE8BB;" Click="DismissStatusClicked"
                                Style="{StaticResource CaptionButton}" Width="24" Height="24" FontSize="10"
                                ToolTip="关闭提示" AutomationProperties.Name="关闭提示"
                                AutomationProperties.AutomationId="DismissStatus" />
                        <TextBlock x:Name="StatusMessage" VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontSize="12.5" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </Border>
        </Grid>
    </Grid>
</Window>
