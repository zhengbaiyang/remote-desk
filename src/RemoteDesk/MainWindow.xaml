                                                           VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="SyncInviteCodePanel" Grid.Row="2" Grid.Column="2" Visibility="Collapsed">
