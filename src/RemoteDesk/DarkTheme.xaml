<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core Typography & Structural Hairlines (Soft macOS Graphite Dark) -->
    <SolidColorBrush x:Key="Ink" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Muted" Color="#98989D" />
    <SolidColorBrush x:Key="Line" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Rim" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Focus" Color="#0A84FF" />

    <!-- Neutral Graphite Surfaces -->
    <SolidColorBrush x:Key="WindowSurface" Color="#1C1C1E" />
    <SolidColorBrush x:Key="Rail" Color="#161618" />
    <SolidColorBrush x:Key="RailMica" Color="#B41A1A1C" />
    <SolidColorBrush x:Key="Frame" Color="#242426" />
    <SolidColorBrush x:Key="Card" Color="#242426" />
    <SolidColorBrush x:Key="SurfaceElevated" Color="#2C2C2E" />
    <SolidColorBrush x:Key="SurfaceSubtle" Color="#323235" />

    <!-- Interactive & Form Controls -->
    <SolidColorBrush x:Key="Quiet" Color="#2C2C2E" />
    <SolidColorBrush x:Key="Hover" Color="#353538" />
    <SolidColorBrush x:Key="Pressed" Color="#3E3E42" />
    <SolidColorBrush x:Key="Primary" Color="#0A84FF" />
    <SolidColorBrush x:Key="PrimaryInk" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryHover" Color="#2E96FF" />
    <SolidColorBrush x:Key="PrimaryPressed" Color="#006EE0" />
    <SolidColorBrush x:Key="DeviceSelected" Color="#200A84FF" />
    <SolidColorBrush x:Key="Field" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Input" Color="#1A1A1C" />
    <SolidColorBrush x:Key="Selection" Color="#440A84FF" />
    <SolidColorBrush x:Key="Glyph" Color="#1E0A84FF" />

    <!-- Single Restrained macOS Dark Blue Accent -->
    <SolidColorBrush x:Key="Accent" Color="#0A84FF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1E0A84FF" />
    <SolidColorBrush x:Key="AccentBorder" Color="#550A84FF" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F8FFF" Offset="0" />
        <GradientStop Color="#0A84FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#389BFF" Offset="0" />
        <GradientStop Color="#1A84F5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0071E3" Offset="0" />
        <GradientStop Color="#005EC4" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF" />

    <!-- Navigation Pills, Segmented Thumbs & Spotlight Motion Tokens -->
    <SolidColorBrush x:Key="NavActivePill" Color="#2C2C2E" />
    <SolidColorBrush x:Key="NavActivePillBorder" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="SegmentThumb" Color="#3A3A3D" />
    <SolidColorBrush x:Key="SegmentThumbBorder" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ToggleTrackOff" Color="#3A3A3E" />
    <Color x:Key="SpotlightGlowColor">#1CFFFFFF</Color>
    <Color x:Key="SpotlightRimColor">#3DFFFFFF</Color>

    <!-- Calm macOS Dark Semantics -->
    <SolidColorBrush x:Key="Ready" Color="#30D158" />
    <SolidColorBrush x:Key="ReadySoft" Color="#1C30D158" />
    <SolidColorBrush x:Key="Warning" Color="#FF9F0A" />
    <SolidColorBrush x:Key="WarningSoft" Color="#1CFF9F0A" />
    <SolidColorBrush x:Key="Danger" Color="#FF453A" />
    <SolidColorBrush x:Key="DangerSoft" Color="#1FFF453A" />
    <SolidColorBrush x:Key="DangerInk" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PurpleAccent" Color="#7D7AFF" />
    <SolidColorBrush x:Key="PurpleSoft" Color="#1C7D7AFF" />
</ResourceDictionary>
