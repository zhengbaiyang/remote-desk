<Window x:Class="RemoteDesk.Streaming.RemoteOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowDrop="True"
        DragOver="OverlayDragOver"
        Drop="OverlayDrop"
        ResizeMode="NoResize"
        Focusable="False">
    <Window.Resources>
        <SolidColorBrush x:Key="GlassBg" Color="#E6111827" />
        <SolidColorBrush x:Key="PillBg" Color="#CC0F172A" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="ReadyBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />

        <Style x:Key="OverlayBtn" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="MutedActive">
                                <Setter TargetName="Bd" Property="Background" Value="#44F59E0B" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Danger">
                                <Setter TargetName="Bd" Property="Background" Value="#44EF4444" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#88EF4444" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Fullscreen Auto-Hide Top Handle + Expanded Floating Toolbar -->
        <Grid x:Name="FullscreenBarRoot"
              Visibility="Collapsed"
              VerticalAlignment="Top"
              HorizontalAlignment="Stretch">
            <!-- Thin translucent pull-tab at screen top edge -->
            <Border x:Name="FullscreenPullTab"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{StaticResource PillBg}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,10,10"
                    Padding="14,4"
                    Cursor="Hand"
                    MouseEnter="PullTabMouseEnter">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="PullTabDot" Width="7" Height="7" Fill="{StaticResource ReadyBrush}" Margin="0,0,7,0" />
                    <Border Width="28" Height="3" CornerRadius="1.5" Background="#88CBD5E1" Margin="0,0,8,0" />
                    <TextBlock x:Name="PullTabHintText" Text="展开控制栏" Foreground="{StaticResource TextMuted}" FontSize="11" />
                </StackPanel>
            </Border>

            <!-- Expanded fullscreen floating control toolbar -->
            <Border x:Name="FullscreenExpandedBar"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,10,0,0"
                    Background="{StaticResource GlassBg}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,7"
                    MouseEnter="ExpandedBarMouseEnter"
                    MouseLeave="ExpandedBarMouseLeave">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="FsStatusDot" Width="8" Height="8" Fill="{StaticResource ReadyBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="FsDeviceNameText"
                               Text="远程主机"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                    <Border Background="#18FFFFFF" CornerRadius="7" Padding="2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="FsOfficeModeBtn"
                                    Content="办公自由"
                                    Style="{StaticResource OverlayBtn}"
                                    Tag="Selected"
                                    Margin="0,0,2,0"
                                    Click="OfficeModeClicked" />
                            <Button x:Name="FsGameModeBtn"
                                    Content="游戏锁定"
                                    Style="{StaticResource OverlayBtn}"
                                    Click="GameModeClicked" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="FsQualityBtn"
                            Content="画质/帧率"
                            Style="{StaticResource OverlayBtn}"
                            Margin="0,0,6,0"
                            Click="QualityClicked" />
                    <Button x:Name="FsFilesBtn"
                            Content="传文件"
                            Style="{StaticResource OverlayBtn}"
                            Margin="0,0,6,0"
                            Click="FileUploadClicked" />
                    <Button x:Name="FsClipboardBtn"
                            Content="剪贴板"
                            Style="{StaticResource OverlayBtn}"
                            Tag="Selected"
                            Margin="0,0,6,0"
                            Click="ClipboardSyncClicked" />
                    <Button x:Name="FsPrivacyBtn"
                            Content="防窥"
                            Style="{StaticResource OverlayBtn}"
                            Margin="0,0,6,0"
                            Click="PrivacyClicked" />
                    <Button x:Name="FsHotkeysBtn"
                            Content="热键/电源"
                            Style="{StaticResource OverlayBtn}"
                            Margin="0,0,6,0"
                            Click="HotkeysClicked" />
                    <Button x:Name="FsMuteBtn"
                            Content="声音"
                            Style="{StaticResource OverlayBtn}"
                            Margin="0,0,6,0"
                            Click="MuteClicked" />
                    <Button x:Name="FsHudBtn"
                            Content="仪表盘"
                            Style="{StaticResource OverlayBtn}"
                            Margin="0,0,6,0"
                            Click="ToggleHudClicked" />
                    <Button x:Name="FsExitFullscreenBtn"
                            Content="退出全屏"
                            Style="{StaticResource OverlayBtn}"
                            Margin="0,0,6,0"
                            Click="ExitFullscreenClicked" />
                    <Button x:Name="FsDisconnectBtn"
                            Content="断开"
                            Style="{StaticResource OverlayBtn}"
                            Tag="Danger"
                            Click="DisconnectClicked" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top-Right Click-Through Telemetry HUD Card -->
        <Border x:Name="TelemetryHudCard"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,14,14,0"
                Background="{StaticResource PillBg}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock x:Name="HudLinkText" Text="P2P 直连" Foreground="{StaticResource ReadyBrush}" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="HudRttText" Text=" · RTT -- ms" Foreground="{StaticResource TextPrimary}" FontSize="11.5" />
                    <TextBlock x:Name="HudCodecText" Text=" · --" Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="HudMetricsText"
                           Text="帧率 --/-- fps · 解码 -- ms · 丢帧 0 · -- Mbps"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="11" />
            </StackPanel>
        </Border>

        <!-- Center Status / Error Card (above HwndHost cleanly via separate owned transparent window) -->
        <Border x:Name="StatusCard"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="460"
                Background="{StaticResource GlassBg}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24,20">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="StatusTitleText"
                           Text="正在建立低延迟远控通道…"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <TextBlock x:Name="StatusDetailText"
                           Text="正在协商 Sunshine 加密会话与 D3D11 硬件解码器"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12.5"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <StackPanel x:Name="StatusActionRow"
                            Visibility="Collapsed"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0">
                    <Button x:Name="StatusRetryBtn"
                            Content="重新连接"
                            Style="{StaticResource OverlayBtn}"
                            Tag="Selected"
                            Margin="0,0,8,0"
                            Click="RetryClicked" />
                    <Button x:Name="StatusCloseBtn"
                            Content="关闭窗口"
                            Style="{StaticResource OverlayBtn}"
                            Click="DisconnectClicked" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bottom-Center Click-Through Toast Banner -->
        <Border x:Name="ToastBanner"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,28"
                Background="{StaticResource GlassBg}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="1"
                CornerRadius="999"
                Padding="16,7">
            <TextBlock x:Name="ToastText"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="12.5"
                       FontWeight="Medium" />
        </Border>
    </Grid>
</Window>
