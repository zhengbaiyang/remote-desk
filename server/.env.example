# ==============================================================================
# RemoteDesk 阿里云自建节点环境变量模板
# 首次运行 `bash server/deploy.sh` 会自动生成 `server/.env` 并创建强随机密钥。
# 如需手动配置，请先复制：cp server/.env.example server/.env
# ==============================================================================

# 阿里云服务器公网 IPv4 或已解析的域名（例如：47.100.12.34 或 relay.example.com）
PUBLIC_HOST=your-aliyun-public-ip-or-domain

# EasyTier 私有虚拟组网名称（接入同一组网的所有设备需填写一致）
# 安全说明：docker-compose.yml 会将该名称自动传入 --relay-network-whitelist，
# 拒绝为其他陌生网络转发流量，防止公网扫描器盗刷你的阿里云带宽。
EASYTIER_NETWORK_NAME=remotedesk-campus

# EasyTier 私有虚拟组网密钥（请务必使用高强度随机密钥；deploy.sh 会自动生成）
EASYTIER_NETWORK_SECRET=change-me-to-a-strong-secret

# EasyTier 主监听端口（同时映射 TCP 和 UDP，默认 11010）
EASYTIER_PORT=11010

# EasyTier WebSocket 备用监听端口（仅 TCP，校园网封锁 UDP/常规端口时可用 ws://<IP>:11011）
EASYTIER_WS_PORT=11011

# 是否同时启用可选的 RustDesk 自建 ID / 中继服务（hbbs + hbbr）
# 设为 true 或执行 `bash server/deploy.sh --with-rustdesk` 即可启动
ENABLE_RUSTDESK=false

# RustDesk 中继服务器对外地址（默认复用 PUBLIC_HOST，通常无需修改）
RUSTDESK_RELAY_HOST=${PUBLIC_HOST}
